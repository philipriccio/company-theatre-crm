# Database
DATABASE_URL="postgresql://user:password@localhost:5432/company_theatre_crm"

# Email delivery: disabled sends no email, mock accepts locally, ses uses AWS SES v2.
EMAIL_PROVIDER="disabled"
# SES refuses every recipient unless listed here as an exact bare email address.
# Comma-separated; no wildcards/domains. Configure only Philip/Janice test inboxes.
# This restriction does NOT replace Philip's explicit approval before each send.
EMAIL_SES_RECIPIENT_ALLOWLIST=""
EMAIL_TOKEN_SECRET="replace-with-at-least-32-random-characters"
AWS_SES_REGION="ca-central-1"
AWS_SES_CONFIGURATION_SET="company-theatre-campaigns"
AWS_SNS_TOPIC_ARN=""

# Legacy SendGrid webhook compatibility is disabled by default.
ENABLE_LEGACY_SENDGRID_WEBHOOK="false"
SENDGRID_WEBHOOK_SIGNATURE=""

# Worker service
EMAIL_WORKER_BATCH_SIZE="10"
EMAIL_WORKER_LEASE_SECONDS="300"
EMAIL_WORKER_IDLE_MS="5000"

# App URLs
NEXT_PUBLIC_APP_URL="https://crm.companytheatre.ca"
NEXT_PUBLIC_BASE_URL="https://crm.companytheatre.ca"

# Docker/Production
POSTGRES_PASSWORD="changeme"
