generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id                 String              @id @default(cuid())
  email              String              @unique
  firstName          String?
  lastName           String?
  fullName           String?
  title              String?
  phone              String?
  city               String?
  state              String?
  country            String?
  totalDonations     Float?              @default(0)
  solicitation       Boolean             @default(true)
  unsubscribedAt     DateTime?
  externalId         String?
  metadata           Json?
  vip                Boolean             @default(false)
  relationshipHealth String?
  lastContactedAt    DateTime?
  personalNotes      String?
  organization       String?
  role               String?
  context            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  campaignRecipients CampaignRecipient[]
  tags               ContactTag[]
  notes              ContactNote[]
  interactions       ContactInteraction[]
  connections        ContactConnection[]
  followUps          ContactFollowUp[]

  @@index([email])
  @@index([unsubscribedAt])
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  color     String       @default("#6366f1")
  createdAt DateTime     @default(now())
  contacts  ContactTag[]

  @@index([name])
}

model ContactTag {
  contactId  String
  tagId      String
  assignedAt DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model ContactNote {
  id         String   @id @default(cuid())
  contactId  String
  content    String
  category   String   @default("general")
  authorName String   @default("Philip")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([category])
}

model ContactInteraction {
  id         String   @id @default(cuid())
  contactId  String
  type       String
  subject    String?
  summary    String?
  emailId    String?
  occurredAt DateTime
  createdAt  DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([occurredAt])
  @@index([type])
}

model ContactConnection {
  id           String   @id @default(cuid())
  contactId    String
  connectedId  String?
  name         String
  relationship String
  notes        String?
  createdAt    DateTime @default(now())
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model ContactFollowUp {
  id          String    @id @default(cuid())
  contactId   String
  description String
  dueDate     DateTime?
  completedAt DateTime?
  priority    String    @default("normal")
  createdAt   DateTime  @default(now())
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([dueDate])
  @@index([completedAt])
}

model Campaign {
  id          String              @id @default(cuid())
  name        String
  subject     String
  fromName    String              @default("The Company Theatre")
  fromEmail   String              @default("hello@companytheatre.ca")
  content     String
  previewText String?
  status      CampaignStatus      @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  links       CampaignLink[]
  recipients  CampaignRecipient[]

  @@index([status])
  @@index([scheduledAt])
}

model CampaignRecipient {
  id          String    @id @default(cuid())
  campaignId  String
  contactId   String
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  bouncedAt   DateTime?
  bounceType  String?
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@index([contactId])
}

model CampaignLink {
  id          String   @id @default(cuid())
  campaignId  String
  originalUrl String
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model Template {
  id        String   @id @default(cuid())
  name      String
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}
