generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id                 String              @id @default(cuid())
  email              String              @unique
  firstName          String?
  lastName           String?
  fullName           String?
  title              String?
  phone              String?
  city               String?
  state              String?
  country            String?
  totalDonations     Float?              @default(0)
  solicitation       Boolean             @default(false)
  unsubscribedAt     DateTime?
  externalId         String?
  metadata           Json?
  vip                Boolean             @default(false)
  relationshipHealth String?
  lastContactedAt    DateTime?
  personalNotes      String?
  organization       String?
  role               String?
  context            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  campaignRecipients CampaignRecipient[]
  tags               ContactTag[]
  notes              ContactNote[]
  interactions       ContactInteraction[]
  connections        ContactConnection[]
  followUps          ContactFollowUp[]

  @@index([email])
  @@index([unsubscribedAt])
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  color     String       @default("#6366f1")
  createdAt DateTime     @default(now())
  contacts  ContactTag[]

  @@index([name])
}

model ContactTag {
  contactId  String
  tagId      String
  assignedAt DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model ContactNote {
  id         String   @id @default(cuid())
  contactId  String
  content    String
  category   String   @default("general")
  authorName String   @default("Philip")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([category])
}

model ContactInteraction {
  id         String   @id @default(cuid())
  contactId  String
  type       String
  subject    String?
  summary    String?
  emailId    String?
  occurredAt DateTime
  createdAt  DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([occurredAt])
  @@index([type])
}

model ContactConnection {
  id           String   @id @default(cuid())
  contactId    String
  connectedId  String?
  name         String
  relationship String
  notes        String?
  createdAt    DateTime @default(now())
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model ContactFollowUp {
  id          String    @id @default(cuid())
  contactId   String
  description String
  dueDate     DateTime?
  completedAt DateTime?
  priority    String    @default("normal")
  createdAt   DateTime  @default(now())
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([dueDate])
  @@index([completedAt])
}

model Campaign {
  id          String              @id @default(cuid())
  name        String
  subject     String
  fromName    String              @default("The Company Theatre")
  fromEmail   String              @default("hello@companytheatre.ca")
  content     String
  replyToEmail String?
  design      Json?
  previewText String?
  status      CampaignStatus      @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  completedAt DateTime?
  pausedAt    DateTime?
  cancelledAt DateTime?
  audienceMode String?
  audienceTagIds String[]          @default([])
  approvedAt  DateTime?
  approvedBy  String?
  approvalNote String?
  frozenRecipientCount Int?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  links       CampaignLink[]
  recipients  CampaignRecipient[]
  attempts    EmailDeliveryAttempt[]
  providerEvents EmailProviderEvent[]

  @@index([status])
  @@index([scheduledAt])
}

model CampaignRecipient {
  id          String    @id @default(cuid())
  campaignId  String
  contactId   String
  email       String
  firstName   String?
  lastName    String?
  fullName    String?
  status      CampaignRecipientStatus @default(QUEUED)
  queuedAt    DateTime @default(now())
  acceptedAt  DateTime?
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  bouncedAt   DateTime?
  bounceType  String?
  suppressedAt DateTime?
  failedAt    DateTime?
  unknownAt   DateTime?
  attemptCount Int @default(0)
  nextAttemptAt DateTime?
  leasedUntil DateTime?
  leaseOwner  String?
  provider    String?
  providerMessageId String?
  lastErrorClass String?
  lastErrorCode String?
  lastErrorMessage String?
  metadata    Json?
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  attempts    EmailDeliveryAttempt[]
  providerEvents EmailProviderEvent[]

  @@unique([campaignId, contactId])
  @@unique([campaignId, email])
  @@index([campaignId])
  @@index([contactId])
  @@index([status, nextAttemptAt])
  @@index([leasedUntil])
  @@index([providerMessageId])
}

model CampaignLink {
  id          String   @id @default(cuid())
  campaignId  String
  originalUrl String
  targetToken String?  @unique
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model EmailDeliveryAttempt {
  id          String   @id @default(cuid())
  campaignId  String
  recipientId String
  provider    String
  startedAt   DateTime @default(now())
  completedAt DateTime?
  outcome     EmailAttemptOutcome
  errorClass  String?
  errorCode   String?
  errorMessage String?
  providerMessageId String?
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient   CampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([recipientId])
  @@index([providerMessageId])
}

model EmailProviderEvent {
  id          String   @id @default(cuid())
  provider    String
  providerEventId String
  providerMessageId String?
  eventType   EmailProviderEventType
  campaignId  String?
  recipientId String?
  emailHash   String?
  occurredAt  DateTime
  payload     Json
  createdAt   DateTime @default(now())
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recipient   CampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([providerMessageId])
  @@index([recipientId])
  @@index([eventType])
}

model GlobalSuppression {
  id          String   @id @default(cuid())
  email       String   @unique
  emailHash   String   @unique
  reason      String
  source      String
  contactId   String?
  campaignId  String?
  recipientId String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  metadata    Json?

  @@index([reason])
  @@index([contactId])
}

model ConsentEvidence {
  id          String   @id @default(cuid())
  contactId   String
  email       String
  source      String
  status      String
  recordedAt  DateTime @default(now())
  metadata    Json?

  @@index([contactId])
  @@index([email])
}

model Template {
  id        String   @id @default(cuid())
  name      String
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  PAUSED
  COMPLETED
  COMPLETED_WITH_FAILURES
  SENT
  CANCELLED
  FAILED
}

enum CampaignRecipientStatus {
  QUEUED
  SENDING
  ACCEPTED
  DELIVERED
  FAILED
  SUPPRESSED
  UNKNOWN
  CANCELLED
}

enum EmailAttemptOutcome {
  ACCEPTED
  TRANSIENT_FAILURE
  PERMANENT_FAILURE
  SUPPRESSED
  UNKNOWN
}

enum EmailProviderEventType {
  ACCEPTED
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
  REJECTED
  DROPPED
  UNKNOWN
}

// Deliberately independent of contact deletion: entry and consent audit evidence survive.
model ScratchEntry {
  id               String   @id @default(cuid())
  submissionId     String   @unique
  promotionId      String
  email            String
  fullName         String?
  contactId        String
  payloadHash      String
  marketingConsent Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([promotionId])
  @@index([contactId])
}

model CampaignReview {
  id String @id @default(cuid())
  campaignId String
  contentHash String
  action String
  author String
  note String
  snapshot Json?
  createdAt DateTime @default(now())

  @@index([campaignId, createdAt])
}
